# Copiar a .env (desarrollo) o pasar como --build-arg al construir la imagen.
# Vite incrusta estos valores en el bundle en tiempo de BUILD: cambiar uno
# exige reconstruir la imagen. No contienen secretos (el cliente es público).

# Emisor OIDC de AM (realm raíz /). Debe coincidir con "issuer" de
# <authority>/.well-known/openid-configuration
VITE_OIDC_AUTHORITY=https://forgeops.arvislab.com/am/oauth2

# Cliente OAuth2 público (sin secret, con PKCE) registrado en AM
VITE_OIDC_CLIENT_ID=mibanco-web

# Debe estar registrada tal cual en "Redirection URIs" del cliente en AM
VITE_OIDC_REDIRECT_URI=https://mibanco.arvislab.com/callback

# Opcional: a dónde vuelve el usuario tras cerrar sesión (por defecto el origen
# de la app). Debe estar en "Post Logout Redirect URIs" del cliente en AM
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://mibanco.arvislab.com/

# Scopes solicitados; cuentas.read es el que exige PingGateway
VITE_OIDC_SCOPE=openid profile cuentas.read

# Base del API expuesto por PingGateway (sin barra final)
VITE_API_BASE_URL=https://forgeops.arvislab.com/ig
